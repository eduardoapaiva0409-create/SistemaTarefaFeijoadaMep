# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publishable

# Só no servidor. Nunca comitar, nunca prefixar com NEXT_PUBLIC_.
# Usada apenas pelas Server Actions de /equipe (criar acesso, trocar senha).
# Sem ela o sistema funciona: dá para cadastrar a pessoa no painel do Supabase.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
